# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/

# --- Virtual Environment ---
.venv/
venv/
env/
ENV/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Environment / Secrets ---
.env
.env.local
.env.production

# --- Reports (generated, not source) ---
reports/*.json
reports/*.md

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- pytest ---
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# --- mypy ---
.mypy_cache/

# --- ruff ---
.ruff_cache/

# --- Jupyter ---
.ipynb_checkpoints/

# --- DeepEval ---
.deepeval/
