# ============================================================
# AI Tweet Generator & Reflection Reviewer — Environment Config
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# --- LLM Configuration ---
OPENAI_API_KEY=your-openai-api-key-here

# Model used for tweet generation (the only agent)
WRITER_MODEL=gpt-4o-mini

# Model used for reflection/review evaluation (NOT an agent)
REVIEWER_MODEL=gpt-4o-mini

# Model used for input safety classification
SAFETY_MODEL=gpt-4o-mini

# Writer creativity (0.0 = deterministic, 1.0 = most creative)
WRITER_TEMPERATURE=0.7

# Reviewer consistency (lower = more consistent scores)
REVIEWER_TEMPERATURE=0.3

# --- Workflow Configuration ---

# Maximum number of writer invocations per request (1 initial + N-1 revisions)
MAX_ATTEMPTS=3

# Maximum tweet length in characters (simple len() counting)
MAX_TWEET_LENGTH=280

# Enable/disable the reflection loop (false = baseline/single-pass mode)
REFLECTION_ENABLED=true

# --- Reflection Thresholds (0.0 to 1.0) ---
# All thresholds must be met for a PASS decision.

RELEVANCE_THRESHOLD=0.80
CLARITY_THRESHOLD=0.80
PROFESSIONALISM_THRESHOLD=0.80
ENGAGEMENT_THRESHOLD=0.70
REQUIREMENT_THRESHOLD=0.85

# --- Input Guardrails ---
MAX_INPUT_LENGTH=2000

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
