# ============================================================
# AI Tweet Generator & Reflection Reviewer — Environment Config
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# --- LLM Configuration ---
# Choose your provider: "auto", "groq", "openai", or "cohere"
LLM_PROVIDER=auto

# Provide at least one API key:
GROQ_API_KEY=your-groq-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# COHERE_API_KEY=your-cohere-api-key-here (used as primary or automatic fallback if Groq fails)

# Optional: Tavily API key for web search grounding (fallback to DuckDuckGo if omitted)
# TAVILY_API_KEY=tvly-your-key-here

# Optional: Custom OpenAI-compatible base URL (defaults to https://api.groq.com/openai/v1 for Groq, https://api.cohere.com/compatibility/v1 for Cohere)
# OPENAI_API_BASE=https://api.groq.com/openai/v1

# Models for Groq: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
# Models for OpenAI: gpt-4o, gpt-4o-mini
# Models for Cohere: command-r-08-2024, command-r-plus-08-2024
WRITER_MODEL=openai/gpt-oss-120b
REVIEWER_MODEL=openai/gpt-oss-120b
SAFETY_MODEL=openai/gpt-oss-20b

# Writer creativity (0.0 = deterministic, 1.0 = most creative)
WRITER_TEMPERATURE=0.7

# Reviewer consistency (lower = more consistent scores)
REVIEWER_TEMPERATURE=0.3

# --- Workflow Configuration ---

# Maximum number of writer invocations per request (1 initial + N-1 revisions)
MAX_ATTEMPTS=3

# Maximum tweet length in characters (simple len() counting)
MAX_TWEET_LENGTH=280

# Enable/disable the reflection loop (false = baseline/single-pass mode)
REFLECTION_ENABLED=true

# Enable/disable real-time web search grounding (Tavily + DuckDuckGo fallback)
SEARCH_ENABLED=true
MAX_SEARCH_RESULTS=3

# --- Reflection Thresholds (0.0 to 1.0) ---
# All thresholds must be met for a PASS decision.

RELEVANCE_THRESHOLD=0.80
CLARITY_THRESHOLD=0.80
PROFESSIONALISM_THRESHOLD=0.80
ENGAGEMENT_THRESHOLD=0.70
REQUIREMENT_THRESHOLD=0.85

# --- Input Guardrails ---
MAX_INPUT_LENGTH=2000

# --- LangSmith Tracing & Observability ---
# Set to "true" to trace all LangGraph workflow nodes, agent tool calling, and LLM calls in LangSmith
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai-tweet-generator
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# Alternative aliases (also supported):
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here
# LANGSMITH_PROJECT=ai-tweet-generator

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
